{
  "name": "teamclaws",
  "version": "2.0.26",
  "description": "Move, share and manage AI agent projects in a TeamClaws cloud workspace. CLI, MCP and agent skills for Claude, ChatGPT, Cursor, Grok and more.",
  "keywords": [
    "teamclaws",
    "teamclaws.com",
    "ai-agents",
    "move-project",
    "share-project",
    "cloud-workspace",
    "agent-hosting",
    "agent-control",
    "control-plane",
    "agent-gateway",
    "agent-sandbox",
    "agent-skills",
    "agent-harness",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "openclaw",
    "claude",
    "cursor",
    "grok"
  ],
  "license": "PolyForm-Shield-1.0.0",
  "homepage": "https://teamclaws.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GetTeamClaws/teamclaws.git"
  },
  "type": "module",
  "private": false,
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "teamclaws": "./dist/cli.js"
  },
  "files": [
    "scripts/check-node.mjs",
    "dist/",
    "skills/",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "preinstall": "node scripts/check-node.mjs",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "audit": "npm audit --audit-level=high",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run build && npm run audit"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.1",
    "eslint": "10.9.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0"
  }
}
